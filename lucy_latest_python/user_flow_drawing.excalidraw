      "updated": 1788677804293,
      "link": null,
      "locked": false,
      "customData": {
        "generationData": {
          "status": "done",
          "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>OS Installation System - Setup Wizard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen text-slate-900 flex flex-col\">\n\n    <!-- Header Navigation -->\n    <header class=\"bg-white border-b border-slate-200 sticky top-0 z-10\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex items-center justify-between\">\n            <div class=\"flex items-center gap-2 font-bold text-xl text-blue-600\">\n                <i class=\"fas fa-microchip\"></i>\n                <span>OSCore Installer</span>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-slate-600\">\n                <a href=\"#\" class=\"hover:text-blue-600 transition-colors\">Documentation</a>\n                <a href=\"#\" class=\"hover:text-blue-600 transition-colors\">Log Files</a>\n                <a href=\"#\" class=\"hover:text-blue-600 transition-colors\">Support</a>\n            </nav>\n            <div class=\"flex items-center gap-4\">\n                <button class=\"px-4 py-2 text-sm font-medium border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors\">\n                    Cancel\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"flex-grow flex items-center justify-center p-6\">\n        <div class=\"max-w-2xl w-full\">\n            \n            <!-- Process Step UI (based on wireframe) -->\n            <div class=\"bg-white border border-slate-200 rounded-3xl p-12 shadow-sm flex flex-col items-center text-center space-y-8\">\n                \n                <!-- Status Icon -->\n                <div class=\"w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 mb-2\">\n                    <i class=\"fas fa-gear fa-spin text-3xl\"></i>\n                </div>\n\n                <!-- Main Content (Matching Image Text) -->\n                <div class=\"space-y-4\">\n                    <h1 class=\"text-2xl font-semibold tracking-tight text-slate-800\">\n                        Environment Setup in Progress\n                    </h1>\n                    <div class=\"border-2 border-slate-200 rounded-2xl py-6 px-10 inline-block transition-all hover:border-blue-300\">\n                        <p class=\"text-lg text-slate-600 leading-relaxed\">\n                            OS installer installs python version, <br>\n                            modules, input capturing scripts\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Progress Bar -->\n                <div class=\"w-full max-w-md space-y-3\">\n                    <div class=\"h-2 w-full bg-slate-100 rounded-full overflow-hidden\">\n                        <div class=\"h-full bg-blue-600 rounded-full transition-all duration-1000\" style=\"width: 65%;\"></div>\n                    </div>\n                    <div class=\"flex justify-between text-xs font-medium text-slate-400\">\n                        <span>Configuring dependencies...</span>\n                        <span>65%</span>\n                    </div>\n                </div>\n\n                <!-- Details/Logs Section -->\n                <div class=\"w-full bg-slate-900 rounded-xl p-4 text-left font-mono text-xs text-blue-400 space-y-1\">\n                    <p>> pip install --upgrade python-3.11</p>\n                    <p>> fetching libraries: numpy, pandas, pynput</p>\n                    <p>> initializing input_capture_v2.py...</p>\n                    <p class=\"text-emerald-400\">> module verification complete.</p>\n                    <span class=\"animate-pulse\">_</span>\n                </div>\n\n            </div>\n\n            <!-- Contextual Help -->\n            <p class=\"mt-8 text-center text-sm text-slate-500\">\n                <i class=\"fas fa-circle-info mr-1\"></i>\n                Please do not turn off your computer during this process. \n                Estimated time remaining: <b>4 minutes</b>.\n            </p>\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-slate-200 py-6\">\n        <div class=\"max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400\">\n            <p>&copy; 2023 OS Core Systems Inc. All rights reserved.</p>\n            <div class=\"flex gap-6\">\n                <a href=\"#\" class=\"hover:underline\">Privacy Policy</a>\n                <a href=\"#\" class=\"hover:underline\">License Agreement</a>\n                <a href=\"#\" class=\"hover:underline\">Version 4.2.0-stable</a>\n            </div>\n        </div>\n    </footer>\n\n</body>\n</html>"
        }
      }
