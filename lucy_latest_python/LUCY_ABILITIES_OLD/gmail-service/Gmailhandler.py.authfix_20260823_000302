class SetupFailure(Exception):
    pass


def setup_gmail():
         creds = get_credentials()
         if creds is None:
                  print("Could not obtain valid credentials.")
                  return

         gmail_service = create_gmail_service(creds)

         if gmail_service is None:
                  print("Could not initialize Gmail.")
                  return
         
         return gmail_service


def main_handler(
    action: str,
    query: str = None,
    count: int = 5
) -> None:


    try:
        # ----------------------------------------
        # Setup (authenticate, create service)
        # ----------------------------------------
        service = setup_gmail()
        
        if service is None:
            raise SetupFailure()

        # ----------------------------------------
        # SEARCH EMAILS
        # ----------------------------------------

        if action == "search":

            if not query:
                raise ValueError("Search action requires a query")

            messages = search_messages(
                service,
                query=query,
                max_results=count,
            )

            if not messages:
                print("No messages found.")
                return

        # ----------------------------------------
        # GET LATEST EMAILS
        # ----------------------------------------

        elif action == "latest":

            messages = search_messages(
                service,
                query="",
                max_results=count,
            )

            if not messages:
                print("No messages found.")
                return

        # ----------------------------------------
        # INVALID ACTION
        # ----------------------------------------
        else:
            raise ValueError(
                f"Unknown gmail action: {action}"
            )

        # ----------------------------------------
        # Retrieve + parse
        # ----------------------------------------

        for message in messages:

            message_id = message.get("id")

            if not message_id:
                print("Message result had no ID. Skipping.")
                continue

            msg = get_full_message(
                service,
                message_id,
            )

            if msg is None:
                continue

            email = parse_message(msg)

            print_message(email)

    except SetupFailure as error:
        print(f"Gmail Setup failed")

    except KeyboardInterrupt:
        print("\nOperation cancelled.")

    except Exception as error:
        print(f"Fatal unexpected error: {error}")


action = input("Specify the action (search/latest) and press Enter to continue: ").strip().lower()

if action == "search":
    query = input("Enter the search query: ")
    main_handler(action=action, query=query)
elif action == "latest":
    main_handler(action=action)