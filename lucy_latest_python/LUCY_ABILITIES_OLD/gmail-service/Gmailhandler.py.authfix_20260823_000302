def save_credentials(creds: Credentials) -> bool:
    """Save Google OAuth credentials to disk."""

    try:
        with open(CREDENTIAL_FILE, "w", encoding="utf-8") as file:
            file.write(creds.to_json())

        return True

    except OSError as error:
        print(f"Failed to save credentials: {error}")
        return False

    except Exception as error:
        print(f"Unexpected error while saving credentials: {error}")
        return False


def run_new_oauth_flow() -> Optional[Credentials]:
    """
    Run Google's OAuth flow.

    This is used:
    - the first time the program runs
    - if the refresh token expires
    - if the refresh token gets revoked
    - if cred.json becomes unusable
    """

    client_config = {
        "installed": {
            "client_id": CLIENT_ID,
            "client_secret": CLIENT_SECRET,
            "auth_uri": "https://accounts.google.com/o/oauth2/auth",
            "token_uri": "https://oauth2.googleapis.com/token",
            "redirect_uris": ["http://localhost"],
        }
    }

    try:
        flow = InstalledAppFlow.from_client_config(
            client_config,
            SCOPES,
        )

        creds = flow.run_local_server(
            port=0,
            access_type="offline",
            prompt="consent",
        )

        if not creds:
            print("OAuth authorization returned no credentials.")
            return None

        if not save_credentials(creds):
            print("OAuth succeeded, but credentials could not be saved.")

        print("Google authorization successful.")

        return creds

    except Exception as error:
        print(f"OAuth authorization failed: {error}")
        return None


def load_credentials() -> Optional[Credentials]:
    """Load credentials from cred.json."""

    if not os.path.exists(CREDENTIAL_FILE):
        print("Credential file does not exist.")
        return None

    try:
        return Credentials.from_authorized_user_file(
            CREDENTIAL_FILE,
            SCOPES,
        )

    except (ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"Credential file is invalid: {error}")
        return None

    except OSError as error:
        print(f"Could not read credential file: {error}")
        return None

    except Exception as error:
        print(f"Unexpected credential loading error: {error}")
        return None


def get_credentials() -> Optional[Credentials]:
    """
    Return valid Google credentials.

    Handles:
    - missing cred.json
    - expired access token
    - revoked/expired refresh token
    - corrupt credential file
    - missing refresh token
    """

    creds = load_credentials()

    # No credentials at all
    if creds is None:
        print("No usable credentials found. Starting authorization.")
        return run_new_oauth_flow()

    # Already valid
    if creds.valid:
        return creds

    # Access token expired but refresh token exists
    if creds.expired and creds.refresh_token:

        try:
            print("Access token expired. Refreshing...")

            creds.refresh(Request())

            if not creds.valid:
                print("Token refresh completed but credentials remain invalid.")
                return run_new_oauth_flow()

            save_credentials(creds)

            print("Access token refreshed successfully.")

            return creds

        except RefreshError as error:
            # Refresh token itself may have expired/revoked
            print(f"Refresh token is no longer usable: {error}")
            print("Starting authorization again.")

            return run_new_oauth_flow()

        except Exception as error:
            print(f"Unexpected token refresh error: {error}")
            return None

    # Credentials invalid with no usable refresh token
    print("Credentials are invalid and cannot be refreshed.")
    print("Starting authorization again.")

    return run_new_oauth_flow()


