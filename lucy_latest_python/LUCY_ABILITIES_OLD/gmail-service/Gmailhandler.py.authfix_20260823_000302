def create_gmail_service(creds: Credentials):
    """Create an authenticated Gmail API service."""

    try:
        return build(
            "gmail",
            "v1",
            credentials=creds,
            cache_discovery=False,
        )

    except Exception as error:
        print(f"Failed to create Gmail service: {error}")
        return None


# ============================================================
# MESSAGE BODY
# ============================================================

def decode_body(data: str) -> Optional[str]:
    """Decode Gmail's base64url encoded message body."""

    if not data:
        return None

    try:
        return base64.urlsafe_b64decode(data).decode(
            "utf-8",
            errors="replace",
        )

    except (ValueError, TypeError) as error:
        print(f"Could not decode message body: {error}")
        return None

    except Exception as error:
        print(f"Unexpected body decoding error: {error}")
        return None


def get_message_body(msg: dict) -> Optional[str]:
    """
    Extract the most readable plain-text body from a Gmail message.
    """

    try:
        payload = msg.get("payload", {})

        # Non-multipart email
        direct_data = payload.get("body", {}).get("data")

        if direct_data:
            return decode_body(direct_data)

        # Multipart email
        def walk(parts) -> Optional[str]:

            try:
                for part in parts:

                    mime_type = part.get("mimeType", "")
                    body = part.get("body", {})
                    data = body.get("data")

                    if mime_type == "text/plain" and data:
                        decoded = decode_body(data)

                        if decoded:
                            return decoded

                    nested_parts = part.get("parts", [])

                    if nested_parts:
                        result = walk(nested_parts)

                        if result:
                            return result

                return None

            except Exception as error:
                print(f"Failed while walking email parts: {error}")
                return None

        return walk(payload.get("parts", []))

    except Exception as error:
        print(f"Failed to extract message body: {error}")
        return None


# ============================================================
# HEADERS
# ============================================================

def clean_return_path(value: str) -> str:
    """
    Convert something like:

    <abc123@mail.payments.interac.ca>

    into:

    mail.payments.interac.ca
    """

    try:
        value = value.strip()

        if "@" not in value:
            return value

        domain = value.rsplit("@", 1)[-1]

        return domain.strip("<> ")

    except Exception:
        return value


def get_useful_headers(msg: dict) -> dict:
    """Return only useful email headers."""

    try:
        headers = msg.get("payload", {}).get("headers", [])

        useful_headers = {}

        for header in headers:

            try:
                name = header.get("name")
                value = header.get("value")

                if not name or value is None:
                    continue

                if name.lower() not in WANTED_HEADERS:
                    continue

                # Normalize header names
                clean_name = name.lower()

                if clean_name == "return-path":
                    value = clean_return_path(value)
                    clean_name = "mailed-by"

                useful_headers[clean_name] = value

            except Exception as error:
                print(f"Failed to parse individual header: {error}")

        return useful_headers

    except Exception as error:
        print(f"Failed to extract email headers: {error}")
        return {}


# ============================================================
# GMAIL SEARCH
# ============================================================

def search_messages(
    gmail_service,
    query: str,
    max_results: int = 10,
) -> list:
    """Search Gmail and return matching message references."""

    try:
        response = (
            gmail_service
            .users()
            .messages()
            .list(
                userId="me",
                q=query,
                maxResults=max_results,
            )
            .execute()
        )

        return response.get("messages", [])

    except HttpError as error:
        print(f"Gmail search failed: {error}")
        return []

    except Exception as error:
        print(f"Unexpected Gmail search error: {error}")
        return []


def get_full_message(
    gmail_service,
    message_id: str,
) -> Optional[dict]:
    """Download the full Gmail message."""

    try:
        return (
            gmail_service
            .users()
            .messages()
            .get(
                userId="me",
                id=message_id,
                format="full",
            )
            .execute()
        )

    except HttpError as error:
        print(
            f"Failed to retrieve message "
            f"{message_id}: {error}"
        )
        return None

    except Exception as error:
        print(
            f"Unexpected error retrieving message "
            f"{message_id}: {error}"
        )
        return None


# ============================================================
# FORMAT MESSAGE
# ============================================================

def parse_message(msg: dict) -> dict:
    """Turn a raw Gmail API message into clean readable data."""

    try:
        return {
            "id": msg.get("id"),
            "thread_id": msg.get("threadId"),
            "labels": msg.get("labelIds", []),
            "headers": get_useful_headers(msg),
            "body": get_message_body(msg),
        }

    except Exception as error:
        print(f"Failed to parse message: {error}")

        return {
            "id": msg.get("id"),
            "thread_id": msg.get("threadId"),
            "labels": [],
            "headers": {},
            "body": None,
        }


def print_message(email: dict) -> None:
    """Print an email in a clean human-readable format."""

    try:
        print("\n" + "=" * 70)

        headers = email.get("headers", {})

        for name, value in headers.items():
            print(f"{name}: {value}")

        labels = email.get("labels", [])

        if labels:
            print(f"labels: {', '.join(labels)}")

        print("-" * 70)

        body = email.get("body")

        if body:
            print(body.strip())
        else:
            print("[No readable text body]")

        print("=" * 70)

    except Exception as error:
         print(f"Failed to print message: {os.error}")


