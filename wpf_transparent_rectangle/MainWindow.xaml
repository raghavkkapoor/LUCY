<Window x:Class="TransparentRectangleWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        Height="390"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="Transparent">
        <Border Width="680"
                Height="320"
                CornerRadius="24"
                Background="#CC7FCBFF"
                BorderBrush="#D9FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Grid.Row="0"
                         Height="48"
                         Margin="0,0,14,0"
                         Padding="14,10"
                         VerticalAlignment="Center"
                         FontSize="18"
                         Background="#E6FFFFFF"
                         Foreground="#FF18324A"
                         BorderThickness="0"
                         ToolTip="Type something..."
                         KeyDown="InputBox_KeyDown" />

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Width="90"
                        Height="48"
                        Content="Exit"
                        FontSize="17"
                        Click="ExitButton_Click" />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Grid.Row="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,100,0"
                        Content="✓"
                        FontSize="24"
                        ToolTip="Send to Gemini"
                        Click="SendButton_Click" />

                <TextBox x:Name="ResponseBox"
                         Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         FontSize="16"
                         Padding="12"
                         Background="#E6FFFFFF"
                         Foreground="#FF18324A"
                         BorderThickness="0"
                         Text="Gemini response will appear here." />
            </Grid>
        </Border>
    </Grid>
</Window>
